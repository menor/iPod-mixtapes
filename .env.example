# Copy to .env and fill in. .env is gitignored — never commit real values.

# Base URL of your remote Plex server, including scheme and port.
# Example: https://plex.example.com:32400
PLEX_BASE_URL=

# Plex authentication token (X-Plex-Token).
# Find it via: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=
