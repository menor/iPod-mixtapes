{
  "name": "ipod-mixtapes",
  "version": "0.1.0",
  "description": "Sync a named Plex playlist onto a 5.5-gen iPod Video. Plex is the source of truth; the iPod is a one-way mirror. Built on the podscribe iTunesDB library.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ipod-mixtapes": "src/cli/sync.ts"
  },
  "scripts": {
    "sync": "node src/cli/sync.ts",
    "typecheck": "tsgo -p tsconfig.json && tsgo -p tsconfig.web.json",
    "test": "node --test 'test/**/*.test.ts'",
    "serve": "node src/server/main.ts"
  },
  "dependencies": {
    "@ctrl/plex": "6.7.0",
    "podscribe": "github:menor/podscribe#6df55f5161d2511fa6e80750283cb20ad262c4c1",
    "preact": "11.0.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  },
  "engines": {
    "node": ">=26.11"
  },
  "allowScripts": {
    "github:menor/podscribe#6df55f5161d2511fa6e80750283cb20ad262c4c1": true
  }
}
